CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=oneplus/sm8250_u_14.0.0_op8t
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_DEPTH=1
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LLVM=1 LLVM_IAS=1
CUT_PYTHON=false

USE_CUSTOM_CLANG=false
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784d

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

LXC_DOCKER=true
ENABLE_NETHUNTER=false
LXC_PATCH=true
ANDROID_PARANOID_NETWORK_OFF=true
MAKEFILE_PATCH=true
CUSTOM_SCRIPT=true
ENABLE_KVM=false

ENABLE_KERNELSU=false
KERNELSU_TAG=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

ENABLE_CCACHE=true
NEED_DTBO=false

BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/3252zzz/LXC-DOCKER-KernelSU_Action/releases/download/boot/boot_b.img
